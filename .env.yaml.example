# Minimal same-origin deployment configuration.
#
# The UI and OAuth/OIDC endpoints are expected to share one public origin:
#   PUBLIC_BASE_URL=https://auth.example.com
#   issuer=https://auth.example.com
#   ui=https://auth.example.com/ui/
#
# Advanced feature, email, federation, observability, and tuning settings are
# documented in docs/operations/configuration.md.

BIND: "0.0.0.0:8000"
PUBLIC_BASE_URL: "http://127.0.0.1:8000"
TRANSPORT_MODE: "loopback-http"
DATABASE_MAX_CONNECTIONS: 32
# Required deployment UUID; rotate before starting any restored candidate.
VALKEY_STATE_EPOCH: "019c8ca2-30a6-7000-8000-00000000e101"
DATA_DIR: "runtime"
# Required: supply a deployment-owned wrapping ID and unpadded base64url 32-byte
# root via SIGNING_KEY_ENCRYPTION_KEY_ID and SIGNING_KEY_ENCRYPTION_KEY[_FILE].
# The root must remain available with the persisted database keyset.
# Default UI is installed once under DATA_DIR/ui/current; replace those files independently.
# UI_ENABLED: false
# UI_STATIC_DIR: "/path/to/custom-ui"
RUST_LOG: "info"
