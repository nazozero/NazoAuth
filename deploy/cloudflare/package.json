{
  "name": "nazoauth-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && node deploy/cloudflare/node_modules/wrangler/bin/wrangler.js dev --config wrangler.toml",
    "bundle": "node bundle.mjs",
    "db:migrate": "cd ../.. && node deploy/cloudflare/node_modules/wrangler/bin/wrangler.js d1 migrations apply NAZO_DB --remote --config wrangler.toml",
    "test": "node --test test/*.mjs",
    "deploy": "cd ../.. && node deploy/cloudflare/node_modules/wrangler/bin/wrangler.js deploy --config wrangler.toml"
  },
  "devDependencies": {
    "miniflare": "5.20261118.0-beta",
    "wrangler": "4.165.0"
  }
}
