+def _collect_sampler_file(container: str, filename: str, out_host: str | Path) -> dict:
+    out_dir = Path(out_host)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    target = out_dir / filename
+    staged = target.with_name(target.name + ".stage")
+    staged.unlink(missing_ok=True)
+    proc = dc("cp", f"{container}:/out/{filename}", str(staged), check=False)
+    if proc.returncode == 0:
+        staged.replace(target)
+    else:
+        staged.unlink(missing_ok=True)
+    return {"container": container, "file": filename, "copied": proc.returncode == 0,
+            "error": proc.stderr[-500:] if proc.returncode else None}
+
