+def _stage_receiver_tls_volume(run_id: str, tls_host: str) -> None:
+    volume = f"{PROJECT}-anchor-tls"
+    inspected = dc("volume", "inspect", volume, "--format", "{{json .Labels}}", check=False)
+    if inspected.returncode == 0:
+        labels = json.loads(inspected.stdout or "{}")
+        if (labels or {}).get(SIS_LABEL) != PROJECT:
+            raise RuntimeError("TLS volume exists without matching task owner")
+    else:
+        dc("volume", "create", "--label", f"{SIS_LABEL}={PROJECT}", volume)
+    name = f"{PROJECT}-anchor-tls-stage"
+    existing = dc("inspect", name, check=False)
+    if existing.returncode == 0:
+        labels = dc("inspect", name, "--format", "{{json .Config.Labels}}", check=False)
+        if (json.loads(labels.stdout or "{}") or {}).get(SIS_LABEL) != PROJECT:
+            raise RuntimeError("TLS staging container exists without matching task owner")
+        dc("rm", "-f", name)
+    dc("run", "-d", "--name", name, "--label", f"{SIS_LABEL}={PROJECT}",
+       "-v", f"{volume}:/tls", "--entrypoint", "sh", PERF_IMAGE, "-c", "sleep 120")
+    try:
+        dc("exec", name, "mkdir", "-p", f"/tls/{run_id}")
+        for filename, mode in (("receiver.crt", "0444"), ("receiver.key", "0400")):
+            source = str(Path(tls_host) / filename)
+            destination = f"/tls/{run_id}/{filename}"
+            sh(["docker", "cp", source, f"{name}:{destination}"])
+            dc("exec", name, "chmod", mode, destination)
+            expected = sh(["sha256sum", source]).stdout.split()[0]
+            actual = dc("exec", name, "sha256sum", destination).stdout.split()[0]
+            if expected != actual:
+                raise RuntimeError(f"TLS staging SHA256 mismatch for {filename}")
+    finally:
+        dc("rm", "-f", name, check=False)
+
