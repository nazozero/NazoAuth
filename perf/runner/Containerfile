FROM rust:1.100.0-slim-trixie@sha256:6f14b2b4b278ec0d50aa1d69541c304ce0f95e0f6268487aa9924af1c2e9aebe AS build
WORKDIR /src/runner
COPY perf/runner/Cargo.toml perf/runner/Cargo.lock ./
COPY perf/runner/src src
RUN cargo build --release --locked
WORKDIR /src/pow
COPY perf/fixture/pow/ ./
RUN RUSTFLAGS="-C target-feature=+crt-static" cargo build --release --locked --target x86_64-unknown-linux-gnu

FROM python:3.13-alpine@sha256:9ef1a599f863231c3d91e941389bfdc4a2d6070557243d54df1a4e57015b960e AS fixture
RUN pip install --no-cache-dir cryptography==46.0.7 fido2==2.0.0 cffi==2.0.0 pycparser==2.23
COPY --from=build /src/pow/target/x86_64-unknown-linux-gnu/release/goose-rauthy-pow /tmp/goose-rauthy-pow
COPY perf/fixture/*.py /tmp/

FROM rust:1.100.0-slim-trixie@sha256:6f14b2b4b278ec0d50aa1d69541c304ce0f95e0f6268487aa9924af1c2e9aebe AS runner
COPY --from=build /src/runner/target/release/oauth-goose /oauth-goose
ENTRYPOINT ["/oauth-goose"]
