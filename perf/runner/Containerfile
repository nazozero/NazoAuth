FROM docker.io/grafana/k6:2.2.0 AS k6

FROM docker.io/library/python:3.14-alpine@sha256:9e9fde4d32eedce0b661d9ab91e826b62dddf28e928c230ec55f1866cac66b01

RUN apk add --no-cache ca-certificates docker-cli \
    && pip install --no-cache-dir "psycopg[binary]==3.3.4" "redis==7.1.0" "argon2-cffi==25.1.0" "cryptography==50.0.0" "blake3==1.0.9"

COPY --from=k6 /usr/bin/k6 /usr/bin/k6
COPY perf /perf

WORKDIR /perf

CMD ["python", "/perf/runner.py"]
