+// writeSample preserves the stock sample envelope and all fields. Avoid
+// repeatedly reflecting the fixed frame and encoding an immutable tag set
+// for every metric in the same request. Uncommon metadata/error cases retain
+// the stock encoder. The periodic flusher owns these buffers and caches.
+func (o *Output) writeSample(sample metrics.Sample, enc *json.Encoder) error {
+	if sample.Metadata != nil || math.IsNaN(sample.Value) || math.IsInf(sample.Value, 0) {
+		return o.writeFallback(sample, enc)
+	}
+	timestamp, err := sample.Time.MarshalJSON()
+	if err != nil {
+		return o.writeFallback(sample, enc)
+	}
+	if o.tagJSON == nil {
+		o.tagJSON = make(map[*metrics.TagSet][]byte)
+		o.metricJSON = make(map[string][]byte)
+	}
+	tags, ok := o.tagJSON[sample.Tags]
+	if !ok {
+		tags = []byte("null")
+		if sample.Tags != nil {
+			tags, err = sample.Tags.MarshalJSON()
+			if err != nil {
+				return err
+			}
+		}
+		if len(o.tagJSON) < 4096 {
+			o.tagJSON[sample.Tags] = tags
+		}
+	}
+	metric, ok := o.metricJSON[sample.Metric.Name]
+	if !ok {
+		metric, err = metrics.MarshalJSONWithoutHTMLEscape(sample.Metric.Name)
+		if err != nil {
+			return err
+		}
+		if len(o.metricJSON) < 4096 {
+			o.metricJSON[sample.Metric.Name] = metric
+		}
+	}
+	b := o.sampleBuffer[:0]
+	b = append(b, `{"metric":`...)
+	b = append(b, metric...)
+	b = append(b, `,"type":"Point","data":{"time":`...)
+	b = append(b, timestamp...)
+	b = append(b, `,"value":`...)
+	b = strconv.AppendFloat(b, sample.Value, 'g', -1, 64)
+	b = append(b, `,"tags":`...)
+	b = append(b, tags...)
+	b = append(b, '}', '}', '\n')
+	err = o.writeFrame(sample.Metric.Name, b)
+	o.sampleBuffer = b
+	return err
+}
+
+// Metric ownership matches the evidence consumer. Cache bounded immutable
+// names; window contracts reach every worker, all other Points exactly one.
+func (o *Output) partitionIndex(name string) int {
+	if index, ok := o.metricPartitions[name]; ok {
+		return index
+	}
+	common := []string{"http_reqs", "http_req_duration", "http_req_blocked",
+		"http_req_connecting", "http_req_tls_handshaking", "http_req_sending",
+		"http_req_waiting", "http_req_receiving", "http_req_failed", "checks",
+		"data_sent", "data_received", "iteration_duration", "iterations",
+		"cap_iter_begin", "cap_iter_end", "cap_iter_ms", "cap_measure_ms",
+		"cap_measure_ops", "cap_measure_errors", "vus", "vus_max", "dropped_iterations"}
+	digest := sha256.Sum256([]byte(name))
+	index := int(binary.BigEndian.Uint32(digest[:4]) % uint32(len(o.partitions)))
+	for ordinal, metric := range common {
+		if metric == name {
+			index = ordinal % len(o.partitions)
+			break
+		}
+	}
+	if o.metricPartitions == nil {
+		o.metricPartitions = make(map[string]int)
+	}
+	if len(o.metricPartitions) < 4096 {
+		o.metricPartitions[name] = index
+	}
+	return index
+}
+
+func (o *Output) writeFrame(metric string, frame []byte) error {
+	if len(o.partitions) == 0 {
+		_, err := o.out.Write(frame)
+		return err
+	}
+	if strings.HasPrefix(metric, "cap_window_") {
+		var errs []error
+		for _, writer := range o.partitions {
+			if _, err := writer.Write(frame); err != nil {
+				errs = append(errs, err)
+			}
+		}
+		return errors.Join(errs...)
+	}
+	_, err := o.partitions[o.partitionIndex(metric)].Write(frame)
+	return err
+}
+
+func (o *Output) writeFallback(sample metrics.Sample, enc *json.Encoder) error {
+	if len(o.partitions) == 0 {
+		return enc.Encode(wrapSample(sample))
+	}
+	var frame bytes.Buffer
+	encoder := json.NewEncoder(&frame)
+	encoder.SetEscapeHTML(false)
+	if err := encoder.Encode(wrapSample(sample)); err != nil {
+		return err
+	}
+	return o.writeFrame(sample.Metric.Name, frame.Bytes())
+}
+
+func (o *Output) flushPartitions() error {
+	var errs []error
+	for _, writer := range o.partitions {
+		if err := writer.Flush(); err != nil {
+			errs = append(errs, err)
+		}
+	}
+	return errors.Join(errs...)
+}
+
+func (o *Output) closePartitions() error {
+	errs := []error{o.flushPartitions()}
+	for _, file := range o.partitionFiles {
+		errs = append(errs, file.Close())
+	}
+	return errors.Join(errs...)
 }
 
