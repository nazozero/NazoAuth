+func TestSampleWriterMatchesStockEnvelope(t *testing.T) {
+	r := metrics.NewRegistry()
+	m, err := r.NewMetric("fixture_metric", metrics.Trend)
+	require.NoError(t, err)
+	tags := r.RootTagSet().With("escaped", "<>&\"\\\n雪").With("cohort", "measure")
+	values := []float64{0, math.Copysign(0, -1), 1.25, 1e-10, 1e22, math.MaxFloat64, math.SmallestNonzeroFloat64}
+	var optimized bytes.Buffer
+	o := &Output{out: &optimized}
+	enc := stdjson.NewEncoder(&optimized)
+	enc.SetEscapeHTML(false)
+	for _, value := range values {
+		for _, metadata := range []map[string]string{nil, {}, {"detail": "<>&\"\\\n雪"}} {
+			for _, tagSet := range []*metrics.TagSet{nil, r.RootTagSet(), tags} {
+				sample := metrics.Sample{TimeSeries: metrics.TimeSeries{Metric: m, Tags: tagSet},
+					Time:  time.Date(2026, 9, 28, 10, 11, 12, 123456789, time.FixedZone("fixture", 8*3600)),
+					Value: value, Metadata: metadata}
+				var stock bytes.Buffer
+				stockEncoder := stdjson.NewEncoder(&stock)
+				stockEncoder.SetEscapeHTML(false)
+				require.NoError(t, stockEncoder.Encode(wrapSample(sample)))
+				optimized.Reset()
+				require.NoError(t, o.writeSample(sample, enc))
+				assert.JSONEq(t, stock.String(), optimized.String())
+				assert.Equal(t, byte('\n'), optimized.Bytes()[optimized.Len()-1])
+			}
+		}
+	}
+	for _, value := range []float64{math.NaN(), math.Inf(1), math.Inf(-1)} {
+		sample := metrics.Sample{TimeSeries: metrics.TimeSeries{Metric: m, Tags: tags}, Time: time.Now(), Value: value}
+		optimized.Reset()
+		assert.Error(t, o.writeSample(sample, enc))
+		assert.Empty(t, optimized.Bytes())
+	}
+	sample := metrics.Sample{TimeSeries: metrics.TimeSeries{Metric: m, Tags: tags}, Time: time.Date(10000, 1, 1, 0, 0, 0, 0, time.UTC)}
+	optimized.Reset()
+	assert.Error(t, o.writeSample(sample, enc))
+	assert.Empty(t, optimized.Bytes())
+}
