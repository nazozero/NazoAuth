+func TestSampleWriterBoundsImmutableTagCache(t *testing.T) {
+	r := metrics.NewRegistry()
+	m, err := r.NewMetric("fixture_metric", metrics.Counter)
+	require.NoError(t, err)
+	var output bytes.Buffer
+	o := &Output{out: &output}
+	enc := stdjson.NewEncoder(&output)
+	for i := 0; i < 4200; i++ {
+		sample := metrics.Sample{TimeSeries: metrics.TimeSeries{Metric: m,
+			Tags: r.RootTagSet().With("dynamic", strconv.Itoa(i))}, Time: time.Now(), Value: float64(i)}
+		output.Reset()
+		require.NoError(t, o.writeSample(sample, enc))
+		// TagSet cannot be unmarshaled outside its registry; inspect generic JSON.
+		var fields map[string]interface{}
+		require.NoError(t, stdjson.Unmarshal(output.Bytes(), &fields))
+		assert.Equal(t, float64(i), fields["data"].(map[string]interface{})["value"])
+		assert.Equal(t, strconv.Itoa(i), fields["data"].(map[string]interface{})["tags"].(map[string]interface{})["dynamic"])
+	}
+	assert.Len(t, o.tagJSON, 4096)
+	assert.Len(t, o.metricJSON, 1)
+}
 
