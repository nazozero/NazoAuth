+func TestQuietPartitionTickFlushesAndPropagatesErrors(t *testing.T) {
+	buffers := []*bytes.Buffer{new(bytes.Buffer), new(bytes.Buffer)}
+	out := &Output{logger: testutils.NewLogger(t)}
+	for _, buffer := range buffers {
+		out.partitions = append(out.partitions, bufio.NewWriterSize(buffer, 65536))
+	}
+	out.out = out.partitions[0]
+	require.NoError(t, out.writeFrame("http_reqs", []byte("first\n")))
+	require.Empty(t, buffers[0].Bytes())
+	out.flushMetrics() // no samples: a quiet tick must still flush prior bytes
+	require.Equal(t, "first\n", buffers[0].String())
+	broken := bufio.NewWriterSize(failingPartitionWriter{}, 65536)
+	out.partitions = []*bufio.Writer{broken}
+	require.NoError(t, out.writeFrame("http_reqs", []byte("pending\n")))
+	require.Error(t, out.flushPartitions())
+}
