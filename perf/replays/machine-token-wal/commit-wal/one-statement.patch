+/// The only mutation for a machine grant is its event. Check the client and
+/// append together under the caller's transaction and client lock. Only the
+/// caller may commit after the statement returns.
+pub(super) async fn append_machine_issuance_on_connection(
+    connection: &mut AsyncPgConnection,
+    input: &nazo_auth::CommitTokenIssuance,
+    event: &SecurityAuditEvent,
+) -> diesel::QueryResult<nazo_auth::CommitTokenIssuanceResult> {
+    use nazo_auth::CommitTokenIssuanceResult::{ClientInactive, Committed};
+
+    #[derive(QueryableByName)]
+    struct Outcome {
+        #[diesel(sql_type = diesel::sql_types::Nullable<diesel::sql_types::Bool>)]
+        changed: Option<bool>,
+    }
+    let rows = MachineAudit {
+        fence: super::token_principals::PrincipalFence(input),
+        append: AuditAppendQuery {
+            event,
+            occurred_at: event.occurred_at.into(),
+        },
+    }
+    .load::<Outcome>(connection)
+    .await?;
+    let [row] = rows.as_slice() else {
+        return Err(invariant_error("invalid machine issuance result count"));
+    };
+    match row.changed {
+        Some(true) => Ok(Committed),
+        None => Ok(ClientInactive),
+        Some(false) => Err(invariant_error(
+            "machine issuance returned an invalid fence or an existing audit event",
+        )),
+    }
+}
+
+#[derive(diesel::query_builder::QueryId)]
+struct MachineAudit<'a> {
+    fence: super::token_principals::PrincipalFence<'a>,
+    append: AuditAppendQuery<'a>,
+}
+impl diesel::query_builder::Query for MachineAudit<'_> {
+    type SqlType = diesel::sql_types::Untyped;
+}
+impl diesel::query_dsl::RunQueryDslSupport for MachineAudit<'_> {}
+impl diesel::query_builder::QueryFragment<diesel::pg::Pg> for MachineAudit<'_> {
+    fn walk_ast<'b>(
+        &'b self,
+        mut out: diesel::query_builder::AstPass<'_, 'b, diesel::pg::Pg>,
+    ) -> diesel::QueryResult<()> {
+        out.push_sql("SELECT CASE WHEN outcome = 'ok' AND client_type IS NOT NULL THEN (");
+        self.append.walk_ast(out.reborrow())?;
+        out.push_sql(") WHEN outcome = 'client_inactive' AND client_type IS NULL THEN NULL ELSE FALSE END AS changed FROM (");
+        self.fence.walk_ast(out.reborrow())?;
+        out.push_sql(") AS principal");
+        Ok(())
+    }
+}
