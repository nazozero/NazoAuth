# syntax=docker/dockerfile:1.7
# Test-only S3 fixture. Latest public releases have no matching server image.
FROM docker.io/library/golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS build-base
ENV CGO_ENABLED=0 GOMAXPROCS=2 GOTOOLCHAIN=local
RUN apk add --no-cache ca-certificates

FROM build-base AS minio-build
ADD --checksum=sha256:45521908307306e925c98d629e1c17d78c8b72b6ee242b1bfb1409f7d8ee5841 https://codeload.github.com/minio/minio/tar.gz/9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a /tmp/source.tar.gz
RUN mkdir /src && tar -xzf /tmp/source.tar.gz -C /src --strip-components=1
WORKDIR /src
RUN --mount=type=cache,id=nazoauth-minio-go-mod,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=nazoauth-minio-go-build,target=/root/.cache/go-build,sharing=locked \
    go build -mod=readonly -p 2 -trimpath \
      -ldflags='-s -w -X github.com/minio/minio/cmd.Version=2025-10-15T17:29:55Z -X github.com/minio/minio/cmd.ReleaseTag=RELEASE.2025-10-15T17-29-55Z -X github.com/minio/minio/cmd.CommitID=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a -X github.com/minio/minio/cmd.ShortCommitID=9e49d5e7a648 -X github.com/minio/minio/cmd.CopyrightYear=2025' \
      -o /out/minio .

FROM build-base AS mc-build
ADD --checksum=sha256:95cd293c7119f16921a6dc515a1fb74a2227f19fd994b9c8b770a154e802ac44 https://codeload.github.com/minio/mc/tar.gz/7394ce0dd2a80935aded936b09fa12cbb3cb8096 /tmp/source.tar.gz
RUN mkdir /src && tar -xzf /tmp/source.tar.gz -C /src --strip-components=1
WORKDIR /src
RUN --mount=type=cache,id=nazoauth-minio-go-mod,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=nazoauth-minio-go-build,target=/root/.cache/go-build,sharing=locked \
    go build -mod=readonly -p 2 -trimpath \
      -ldflags='-s -w -X github.com/minio/mc/cmd.Version=2025-08-13T08:35:41Z -X github.com/minio/mc/cmd.ReleaseTag=RELEASE.2025-08-13T08-35-41Z -X github.com/minio/mc/cmd.CommitID=7394ce0dd2a80935aded936b09fa12cbb3cb8096 -X github.com/minio/mc/cmd.ShortCommitID=7394ce0dd2a80 -X github.com/minio/mc/cmd.CopyrightYear=2025' \
      -o /out/mc .

FROM docker.io/library/debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
LABEL io.nazoauth.scope="test-fixture" \
      io.nazoauth.minio.source="9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a" \
      io.nazoauth.mc.source="7394ce0dd2a80935aded936b09fa12cbb3cb8096"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir /data && chown 10001:10001 /data
COPY --from=minio-build /out/minio /usr/local/bin/minio
COPY --from=mc-build /out/mc /usr/local/bin/mc
COPY --from=minio-build /src/LICENSE /usr/share/doc/minio/LICENSE
COPY --from=mc-build /src/LICENSE /usr/share/doc/mc/LICENSE
ENV HOME=/tmp
WORKDIR /data
USER 10001:10001
ENTRYPOINT ["minio"]
CMD ["server", "/data"]
