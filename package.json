{
  "name": "nazoauth-worker-deploy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm ci --prefix deploy/cloudflare && sh deploy/cloudflare/prepare-build.sh",
    "deploy": "sh deploy/cloudflare/publish.sh",
    "bootstrap": "node deploy/cloudflare/bootstrap.mjs",
    "test:deploy": "node --test deploy/cloudflare/test/deployment.mjs"
  },
  "cloudflare": {
    "bindings": {
      "NAZO_DB": {
        "description": "A fresh D1 database is created automatically. NazoAuth requires first-run offline key and account provisioning before its HTTPS issuer can be enabled."
      }
    }
  }
}
